{
  "name": "display-google",
  "version": "1.0.0",
  "description": "Desktop wallpaper application for Google Calendar and TODO",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build"
  },
  "keywords": [
    "electron",
    "wallpaper",
    "google-calendar",
    "google-tasks"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.11"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "dotenv": "^17.4.2",
    "electron-store": "^8.1.0",
    "googleapis": "^131.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
